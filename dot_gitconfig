[user]
	name = Adam Švestka
	email = svestka.adam1@gmail.com
	; signingkey = 9000EC01C41A2B9E
[core]
	autocrlf = false
	safecrlf = true
	pager = less -R
[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
	hist = log --pretty=format:'%h %ad %G? | %s%d [%an]' --graph --date=short
	type = cat-file -t
	dump = cat-file -p
	undo = reset --soft HEAD~1
[pull]
	rebase = false
[init]
	defaultBranch = main
[commit]
	; gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rerere]
	enabled = true
[advice]
  detachedHead = false
[lfs]
	locksverify = true
